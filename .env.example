# Copy to .env, fill in, and pass it with: docker run --env-file .env ...
# Lines starting with # are ignored. Never commit the filled-in file.

# --- Required ---------------------------------------------------------------

# The address people use to reach the app, without a trailing path. It goes
# into every link and QR code, and form posts from any other origin are
# refused, so it must match what the browser shows exactly.
APP_URL=https://gifts.example.com

# How the organiser pages under /admin are protected: password or proxy.
ADMIN_AUTH=password

# --- Password mode (ADMIN_AUTH=password) ------------------------------------

# Both are left empty on purpose: the app refuses to start until you set
# them, so a forgotten value never leaves a known password in place.

# The organiser password, at least 12 characters. Changing it logs everyone
# out. Pick your own, or generate one with:
#   openssl rand -base64 18
ADMIN_PASSWORD=

# Signs the login cookie, at least 32 characters. Generate one with:
#   openssl rand -base64 48
SESSION_SECRET=

# --- Proxy mode (ADMIN_AUTH=proxy) ------------------------------------------

# Required in proxy mode, optional in password mode. Comma-separated IP
# addresses or CIDR ranges of your reverse proxy as the container sees it,
# not its public address: a proxy container on the same Docker network has
# its address on that network; a proxy on the Docker host usually shows up
# as the network's gateway.
# In proxy mode the proxy must apply its login (forward auth) to everything
# except /p/, /static/ and /health, and pass the user name in a header.
# In password mode behind a proxy, set this too, otherwise every visitor
# shares one rate-limit bucket.
#TRUSTED_PROXIES=192.0.2.10

# Proxy mode: the header holding the logged-in user name. Default Remote-User.
#ADMIN_USER_HEADER=Remote-User

# --- Email (optional) -------------------------------------------------------

# Leave SMTP_HOST unset to run with email off: nothing is mailed and you
# share each person's link yourself.
#SMTP_HOST=smtp.example.com
# 587 uses STARTTLS (required, never plain text); 465 uses TLS from the start.
#SMTP_PORT=587
# Leave both empty if the server needs no login.
#SMTP_USER=gifts@example.com
#SMTP_PASS=smtp-password
# Required when SMTP_HOST is set: the sender address people see.
#SMTP_FROM=Gift Draw <gifts@example.com>
# The name the app gives the mail server when it connects (EHLO). Defaults to
# the domain in APP_URL; set it when that is a name without a dot, such as
# localhost, or an IP address.
#SMTP_NAME=gifts.example.com
# Seconds between two mails, 0 to 300, so a round for a whole class does not
# arrive at once. Default 5; 0 sends without waiting.
#SMTP_SEND_INTERVAL=5
# Mails sent over one connection before the app reconnects, 1 to 1000. Some
# shared mail hosts hold back every mail past the 10th of a connection.
# Default 10.
#SMTP_MAX_MESSAGES=10

# --- Optional ---------------------------------------------------------------

# Time zone for dates, the 09:00 auto-open and reminders. Default Europe/Amsterdam.
#TZ=Europe/Amsterdam

# fatal, error, warn, info, debug, trace or silent. Default info.
#LOG_LEVEL=info

# The image already sets these; change them only outside the container.
#PORT=3000
#DB_PATH=/data/giftdraw.db
